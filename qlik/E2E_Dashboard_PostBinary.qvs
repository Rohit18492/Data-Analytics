// ============================================================================
// E2E Dashboard — post-binary application script (performance-tuned)
// ============================================================================
// Intent preserved:
//   - South Elgin → St. Charles alias (Jagaesh / 4751)
//   - LOC still loaded as [LOC TEMP] (BI-3788) for downstream use
//   - Drop unused binary tables; rebuild M_REGIONS; filter F_FACT; append stepdown
//
// Performance changes vs. original:
//   1. One location-alias mapping reused everywhere (no repeated Lower/If).
//   2. Removed M_REGIONS_2 full resident copy. After the alias is applied at
//      load, the second If([Original Location Name]='south elgin' ...) never
//      matched — it was a full table clone for dead logic.
//   3. DimLocation QVD read once for keys 279/281/282 (was three full scans).
//   4. Stepdown QVD read once (optimized, no WHERE), then Resident-split into
//      F_FACT and M_REGIONS (was two unoptimized QVD loads).
//   5. DimLocation extract: optimized QVD load, then Resident filter
//      (WHERE on QVD was unoptimized).
//   6. MC_KPI_Region_Sort queried once; both mapping tables from Resident.
//   7. Programs nested IF replaced with Pick/Match (same Dual values).
//   8. F_FACT preceding loads collapsed; extra ']' on AUX field removed.
// ============================================================================

binary lib://Qlik Sense Apps/659fb6c8-d164-4be0-87e0-8c4707d2f8e9;
binary lib://Qlik Sense Apps/a8e7372b-ed76-4e46-9a07-2e613aaf74dd;


SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='MM/DD/YY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=0;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';


$(Must_Include=[lib://RCA_Scripts_Location/0.Base Variable/LEVEL_4_App_Path.txt]);


//$(Must_Include=[lib://RCA_Scripts_Location/4.Application/E2E_Dashboard.txt]);


// Location display alias (applied at load — no extra resident pass)
MAP_LOCATION_ALIAS:
Mapping LOAD * INLINE [
From, To
south elgin, St. Charles
];


// ---------------------------------------------------------------------------
// Drop unused tables brought in by binary (frees RAM before rebuilds)
// ---------------------------------------------------------------------------
Drop Table M_REGIONS;
Drop Table [F_ShoutoutContacts];
Drop Table [M_SpecialtyTrack];


// ---------------------------------------------------------------------------
// M_REGIONS
// ---------------------------------------------------------------------------
[M_REGIONS]:
NoConcatenate
LOAD
    %Campaign_Region_KEY,
    %Campaign_KEY,
    %FACT_to_FACILITY_KEY,
    %FACT_to_FACILITY_KEY as %FACT_to_FACILITY_KEY_REGIONS,
    Campaign,
    [Campaign Category],
    SKILL_KEY,
    [Skill Name],
    "Mission Center Region" as "Old Mission Center Region",
    "Location Name",
    "Location Name New",
    ApplyMap('MAP_LOCATION_ALIAS', Lower([Original Location Name]), [Original Location Name]) as [Original Location Name],
    "Contact Location Name",
    %Location_Key,
    "Location ID",
    Neighborhood,
    Unit,
    "Region Source",
    "Level of Care Name" AS [LOC TEMP]
FROM
    [lib://QlikSense QVD Location (ad_svc-qlikadmin)/QlikSense/QVD/Transformed/E2E L2 Transform/7.MasterData/M_Regions.qvd]
    (qvd);


// Can be removed after location source is dimLocation.
// Optimized QVD load, then filter in RAM (Exists/LogicalDelete would un-optimize the QVD).
TMP_DIMLOCATION:
LOAD
    LocationKey,
    Location_Value,
    program_X_tx_setting_value,
    LogicalDeleteInd
FROM
    [lib://RCA_File_Server/Extracts/E2E L1 Extract/07.MasterData/DimLocation.qvd]
    (qvd);

Concatenate (M_REGIONS)
LOAD DISTINCT
    LocationKey as [%FACT_to_FACILITY_KEY],
    ApplyMap('MAP_LOCATION_ALIAS', Lower(Location_Value), Location_Value) as [Original Location Name],
    If(program_X_tx_setting_value = 'Outpatient', 'DH', 'IP') AS [LOC TEMP]
Resident TMP_DIMLOCATION
Where
    LogicalDeleteInd = 'N'
    and not Exists([Original Location Name], Location_Value)
    and Location_Value <> 'Do not use';

Drop Table TMP_DIMLOCATION;


// Monroeville / Bracebridge overrides — one optimized DimLocation scan
TMP_DIMLOCATION_OVERRIDES:
LOAD
    LocationKey
FROM [lib://$(vG.MasterData_ExtractPath)/DimLocation.qvd]
(qvd);

Concatenate (M_REGIONS)
LOAD
    LocationKey AS %FACT_to_FACILITY_KEY,
    Pick(Match(LocationKey, 279, 281, 282), 'Monroeville', 'Bracebridge', 'Bracebridge') as [Location Name New],
    Pick(Match(LocationKey, 279, 281, 282), 'Monroeville', 'Bracebridge', 'Bracebridge') as [Original Location Name]
Resident TMP_DIMLOCATION_OVERRIDES
Where Match(LocationKey, 279, 281, 282);

Drop Table TMP_DIMLOCATION_OVERRIDES;


CAMPAIGN_MAPPING:
Mapping LOAD
    [%Campaign_KEY],
    Campaign
Resident M_REGIONS;


// ---------------------------------------------------------------------------
// Region sort / active — one SQL round-trip
// ---------------------------------------------------------------------------
LIB CONNECT TO 'DW Prod';

TMP_MC_KPI_REGION_SORT:
SQL SELECT
    Region,
    "Sort order",
    Active
FROM "RCA_DW".dbo."MC_KPI_Region_Sort";

[Mapping Region Sort Order]:
Mapping LOAD
    Region as [Mission Center Region2],
    Num#([Sort order])
Resident TMP_MC_KPI_REGION_SORT;

[Mapping Region Active Flag]:
Mapping LOAD
    Region as [Mission Center Region2],
    Active
Resident TMP_MC_KPI_REGION_SORT;

Drop Table TMP_MC_KPI_REGION_SORT;
DISCONNECT;


// ---------------------------------------------------------------------------
// F_FACT — single resident pass + preceding load for ApplyMap
// ---------------------------------------------------------------------------
F_FACT_2:
NoConcatenate
LOAD
    *,
    ApplyMap('Mapping Region Active Flag', [Mission Center Region2], 1) as [Mission Center Region Active Flag],
    ApplyMap('Mapping Region Sort Order', [Mission Center Region2], 9999) as [Mission Center Region Sort];
LOAD
    *,
    ApplyMap('CAMPAIGN_MAPPING', [Contact Campaign Key], '') as CampaignName,
    If(Len(Trim([Mission Center Region])) = 0, [Contact Channel], [Mission Center Region]) as [Mission Center Region2],
    [%FACT_to_FACILITY_KEY] as AUX_FACT_to_FACILITY_KEY
Resident F_FACT
Where [Level of Care] <> 'MAT'
    and %YearFilter >= '2023';

Drop Table F_FACT;
Rename Table F_FACT_2 to F_FACT;

Drop Field [Mission Center Region];
Rename Field [Mission Center Region2] to [Mission Center Region];


// ---------------------------------------------------------------------------
// Stepdown — one QVD read, then two Resident concatenates
// ---------------------------------------------------------------------------
// If this QVD is very large and stepdown=1 is rare, add `Where stepdown = 1`
// on this LOAD (unoptimized QVD) to cap RAM instead of filtering on Resident.
TMP_STEPDOWN:
LOAD
    'stepdown' & location_value as [%FACT_to_FACILITY_KEY],
    Date(Floor(transaction_dt), 'MMM-DD-YYYY') as %Date_KEY,
    Pick(Match(program_x_rrg_code, 2, 3, 4, 5, 6, 9, 10, 13),
        Dual('IP-Detox', 1),
        Dual('IP-Residential', 2),
        Dual('DH-PHP', 3),
        Dual('DH-IOP', 4),
        Dual('DH-GOP', 5),
        Dual('MAT-OTP', 6),
        Dual('MAT-IOP', 7),
        Dual('MAT-OBOT', 8)
    ) as Programs,
    ct as [Stepdown Counter],
    stepdown,
    ApplyMap('MAP_LOCATION_ALIAS', Lower(location_value), location_value) as [Original Location Name]
FROM
    [lib://QlikSense QVD Location (ad_svc-qlikadmin)/QlikSense/QVD/Extracts/E2E L1 Extract/04.ALOS/RT_Discharge_Stepdown_ALOS.qvd]
    (qvd);

Concatenate (F_FACT)
LOAD
    [%FACT_to_FACILITY_KEY],
    %Date_KEY,
    Programs,
    [Stepdown Counter],
    stepdown
Resident TMP_STEPDOWN
Where stepdown = 1;

Concatenate (M_REGIONS)
LOAD DISTINCT
    [%FACT_to_FACILITY_KEY],
    [Original Location Name]
Resident TMP_STEPDOWN
Where stepdown = 1;

Drop Table TMP_STEPDOWN;
